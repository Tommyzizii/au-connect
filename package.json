{
  "name": "au-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:backfill-user-defaults": "tsx migration_scripts/backfill-user-defaults.ts",
    "db:backfill-post-moderation": "tsx migration_scripts/backfill-post-moderation-status.ts",
    "db:seed": "tsx migration_scripts/seed-local-test-data.ts",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test:content": "NODE_OPTIONS=--conditions=react-server tsx --test tests/*.test.ts",
    "test": "pnpm test:content",
    "typecheck": "tsc --noEmit",
    "skills:prepare": "tsx scripts/prepare-skill-catalogue.ts",
    "skills:prepare:check": "tsx scripts/prepare-skill-catalogue.ts --check",
    "skills:bootstrap:dry": "tsx scripts/bootstrap-skills.ts",
    "skills:bootstrap": "tsx scripts/bootstrap-skills.ts --write",
    "skills:import:dry": "tsx scripts/import-skill-catalogue.ts --dry-run",
    "skills:import": "tsx scripts/import-skill-catalogue.ts --write",
    "skills:reset:dry": "tsx scripts/reset-skill-data.ts --dry-run",
    "skills:reset": "tsx scripts/reset-skill-data.ts --confirm-reset-skills"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.29.1",
    "@prisma/client": "6.19.0",
    "@tanstack/react-query": "^5.90.12",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vidstack/react": "^1.12.13",
    "bcrypt": "^6.0.0",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.554.0",
    "next": "16.3.8",
    "nodemailer": "^8.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-virtuoso": "^4.18.1",
    "resend": "^6.9.2",
    "server-only": "^0.0.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
